+#if defined(GR33N_PS3)
+/* GR33N_PS3: PSL1GHT no tiene getaddrinfo.
+ *
+ * Comprobado enlazando de verdad, no leyendo cabeceras: deps/sonda-sockets.sh
+ * dice que la consola SI trae socket, bind, connect, close, setsockopt,
+ * getsockname, send/recv, sendto/recvfrom, inet_pton, inet_ntop y las cuatro
+ * de orden de bytes -- o sea casi toda la API de BSD-- pero NO getaddrinfo
+ * ni freeaddrinfo. Lo que tiene para resolver nombres es netGetHostByName.
+ *
+ * Por eso se reescribe la funcion entera en vez de fabricar un getaddrinfo
+ * falso: struct addrinfo puede no existir siquiera en este netdb.h, y montar
+ * una lista enlazada de estructuras que quiza no estan declaradas para luego
+ * recorrerla y liberarla es mucho aparato para lo que aqui se hace, que es
+ * quedarse con la PRIMERA direccion IPv4.
+ *
+ * CUIDADO CON netGetHostByName, QUE NO ES gethostbyname. Devuelve un
+ * struct net_hostent en el que h_addr_list NO es un char**: es un u32 que
+ * contiene la direccion de una lista de u32, y cada uno de esos contiene la
+ * direccion de los cuatro bytes. Dos indirecciones a mano. No es una
+ * suposicion: es lo que hace net_tls.c:357 de GR33N, que lleva semanas
+ * resolviendo los nombres de Microsoft desde la consola.
+ *
+ * IPv6 no se contempla y esta bien: la PS3 no lo habla, CONFIG_IPV6 es 0, y
+ * la unica direccion IPv6 que da xCloud es Teredo -- un tunel sobre IPv4 que
+ * tampoco podriamos usar. */
+int ports_resolve_addr(const char* host, Address* addr) {
+  char addr_string[ADDRSTRLEN];
+  struct net_hostent* he;
+  uint32_t* lista;
+  uint32_t primera;
+
+  if (host == NULL || addr == NULL)
+    return -1;
+
+  he = netGetHostByName(host);
+  if (he == NULL) {
+    LOGE("netGetHostByName(%s) no resolvio", host);
+    return -1;
+  }
+
+  /* Solo IPv4 de 4 bytes. Cualquier otra cosa se rechaza en vez de
+   * copiarse a medias: un h_length distinto de 4 con un memcpy de 4
+   * es leer fuera. */
+  if (he->h_addrtype != AF_INET || he->h_length != 4) {
+    LOGE("%s resolvio a algo que no es IPv4 (tipo %d, %d bytes)", host,
+         he->h_addrtype, he->h_length);
+    return -1;
+  }
+
+  if (he->h_addr_list == 0) {
+    LOGE("%s resolvio sin lista de direcciones", host);
+    return -1;
+  }
+
+  lista = (uint32_t*)(uintptr_t)he->h_addr_list;
+  if (lista[0] == 0) {
+    LOGE("%s resolvio con la lista vacia", host);
+    return -1;
+  }
+
+  primera = lista[0];
+
+  addr_set_family(addr, AF_INET);
+  memcpy(&addr->sin.sin_addr, (void*)(uintptr_t)primera, 4);
+
+  addr_to_string(addr, addr_string, sizeof(addr_string));
+  LOGI("Resolved %s -> %s", host, addr_string);
+  return 0;
+}
