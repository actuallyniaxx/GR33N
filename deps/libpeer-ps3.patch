+   * primer dia, y no arrastra el fd_set roto de PSL1GHT --FD_SETSIZE
+   * dice 1024 y la estructura tiene sitio para 512-- a un bucle que se
+   * ejecuta miles de veces por conexion.
+   *
+   * De paso se arregla el segundo fallo de esta funcion, que estaba en
+   * el original: el bucle de FD_ISSET recorria SIEMPRE dos sockets
+   * mientras el de FD_SET solo rellenaba uno con CONFIG_IPV6 a cero.
+   * Leia un socket sin inicializar. Aqui se recorren los que de verdad
+   * se metieron. */
+  int ret = -1;
+  int i, n = 0;
+  int idx[2];
+  struct pollfd pfd[2];
+  int addr_type[] = { AF_INET,
+#if CONFIG_IPV6
+                      AF_INET6,
+#endif
+  };
+
+  for (i = 0; i < (int)(sizeof(addr_type) / sizeof(addr_type[0])); i++) {
+    if (agent->udp_sockets[i].fd < 0) {
+      continue;
+    }
+    idx[n] = i;
+    pfd[n].fd = agent->udp_sockets[i].fd;
+    pfd[n].events = POLLIN;
+    pfd[n].revents = 0;
+    n++;
+  }
