diff --git a/usrsctplib/netinet/sctp_callout.c b/usrsctplib/netinet/sctp_callout.c
index ee6cd4c..c4327f4 100755
--- a/usrsctplib/netinet/sctp_callout.c
+++ b/usrsctplib/netinet/sctp_callout.c
@@ -199,6 +199,64 @@ user_sctp_timer_iterate(void *arg)
 	for (;;) {
 #if defined(_WIN32)
 		Sleep(TIMEOUT_INTERVAL);
+#elif defined(GR33N_PS3)
+		/* GR33N_PS3: la newlib de PSL1GHT no trae nanosleep. Trae
+		 * usleep, y ese SI funciona de verdad en la consola: GR33N lo
+		 * usa desde ocho modulos, incluido el decodificador a 135 fps
+		 * con esperas de 200 us.
+		 *
+		 * NO ES UN CAMBIO COSMETICO. Este bucle es el latido que
+		 * dispara TODOS los temporizadores de SCTP -retransmision,
+		 * heartbeats, caducidad de la cookie-, o sea justo la
+		 * propiedad por la que se descarto el SCTP propio de libpeer.
+		 * Si esta espera no espera, el hilo se come un nucleo del PPU
+		 * entero; si espera de menos, los temporizadores van adelantados
+		 * y SCTP retransmite antes de tiempo.
+		 *
+		 * Por eso se mide el reloj en vez de fiarse de una sola
+		 * llamada: lo que el codigo de arriba consigue reintentando
+		 * nanosleep con el resto -dormir el intervalo COMPLETO pase lo
+		 * que pase-, aqui se consigue mirando cuanto ha pasado de
+		 * verdad. En lv2 no hay senales que interrumpan una espera,
+		 * asi que en la practica se sale a la primera vuelta; el bucle
+		 * esta por si esa suposicion deja de ser cierta, que es
+		 * exactamente la clase de suposicion que ya ha mordido a este
+		 * proyecto. */
+		{
+			struct timeval ini, ahora, pasado, tope;
+
+			tope.tv_sec = 0;
+			tope.tv_usec = TIMEOUT_INTERVAL * 1000;
+
+			gettimeofday(&ini, NULL);
+			for (;;) {
+				usleep(TIMEOUT_INTERVAL * 1000);
+
+				gettimeofday(&ahora, NULL);
+				timersub(&ahora, &ini, &pasado);
+
+				/* `tv_sec != 0` cubre dos casos de golpe, y
+				 * los dos tienen que salir del bucle:
+				 *
+				 *   positivo -> ha pasado un segundo o mas,
+				 *               o sea muchisimo mas de 10 ms;
+				 *   negativo -> el reloj ha saltado hacia
+				 *               atras. timersub normaliza a
+				 *               la manera de BSD, asi que un
+				 *               resultado negativo deja los
+				 *               segundos en negativo y los
+				 *               microsegundos positivos: por
+				 *               eso NO vale mirar tv_usec.
+				 *
+				 * Con el reloj atrasado se sale enseguida y el
+				 * tick va adelantado. Es mejor que la
+				 * alternativa, que es un hilo atascado aqui
+				 * hasta que el reloj recupere. */
+				if (pasado.tv_sec != 0 ||
+				    !timercmp(&pasado, &tope, <))
+					break;
+			}
+		}
 #else
 		struct timespec amount, remaining;
 
