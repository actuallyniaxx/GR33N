 }
 
+void
+finish_random(void)
+{
+	return;
+}
+#elif defined(GR33N_PS3)
+/* PS3 (PSL1GHT / lv2): sysGetRandomNumber es el generador del hipervisor,
+ * el mismo del que ya come mbedTLS en GR33N.
+ *
+ * DOS CAUTELAS, las mismas que en net_tls.c y por los mismos motivos:
+ *
+ *   1. Se pide en multiplos de 8. La syscall lo espera asi, y pedirle 5
+ *      bytes puede devolver error o escribir de mas.
+ *   2. No se confia solo en el codigo de retorno. Si la syscall fuera un
+ *      hueco que no hace nada, ese codigo podria salir bien igualmente, y
+ *      una fuente de entropia rota no da error: da claves predecibles.
+ *      Aqui no se puede devolver fallo -la firma no lo permite-, asi que
+ *      al menos se deja constancia por la salida estandar, que GR33N
+ *      reenvia al servidor de depuracion.
+ */
+/* De donde sale la declaracion de sysGetRandomNumber NO SE ADIVINA AQUI.
+ *
+ * La primera version de esto puso <lv2/random.h> porque sonaba bien. No
+ * existe, y los 23 ficheros se enteraron a la vez. La cabecera buena la
+ * averigua build-usrsctp.sh probando a compilar una llamada con cada
+ * candidata -- <lv2/system.h>, <sys/random_number.h>, <ppu-lv2.h>... -- y
+ * escribe la ganadora en gr33n_ps3_random.h. Si ninguna cuela, deja ahi el
+ * prototipo a mano y lo dice por pantalla.
+ *
+ * Es el mismo remedio que con BYTE_ORDER y con struct iovec: preguntarle al
+ * compilador en vez de acordarse. */
+#include <stdio.h>
+#include <string.h>
+#include "gr33n_ps3_random.h"
+
+void
+init_random(void)
+{
+	return;
+}
+
+void
+read_random(void *buf, size_t size)
+{
+	unsigned char tmp[64];
+	unsigned char *out = (unsigned char *)buf;
+	size_t done = 0;
+
+	while (done < size) {
+		size_t chunk = size - done;
+		size_t ask, i;
+		int todo_ceros = 1;
+
+		if (chunk > sizeof(tmp))
+			chunk = sizeof(tmp);
+
+		ask = (chunk + 7u) & ~(size_t)7u;
+
+		memset(tmp, 0, sizeof(tmp));
+		sysGetRandomNumber(tmp, (uint64_t)ask);
+
+		for (i = 0; i < ask; i++)
+			if (tmp[i]) { todo_ceros = 0; break; }
+
+		if (todo_ceros) {
+			printf("[usrsctp] !! sysGetRandomNumber devolvio solo ceros: "
+			       "SCTP con entropia predecible\n");
+		}
+
+		memcpy(out + done, tmp, chunk);
+		done += chunk;
+	}
+}
+
 void
 finish_random(void)
 {
